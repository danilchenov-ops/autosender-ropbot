# ── Битрикс24 ────────────────────────────────────────────────────────────────
# Входящий вебхук с правами: telephony, crm, user, disk
# Вид: https://вашпортал.bitrix24.ru/rest/1/КОД/
B24_WEBHOOK=

# ── Postgres ─────────────────────────────────────────────────────────────────
PG_PASSWORD=смените_этот_пароль

# ── Сбор данных ──────────────────────────────────────────────────────────────
BACKFILL_DAYS=90          # сколько дней истории забрать при первом запуске
POLL_INTERVAL=300         # опрос Битрикса, секунды
B24_RATE_SLEEP=0.5        # пауза между запросами (2 запроса/сек = лимит Битрикса)

SYNC_CRM=1                # тянуть лиды, сделки, контакты, стадии, дела
CRM_SINCE_DAYS=90         # глубина сбора CRM: архив старше этого срока не тянем

# ── Расшифровка ──────────────────────────────────────────────────────────────
MIN_CALL_SEC=30           # звонки короче не расшифровываем
WHISPER_MODEL=small       # tiny / base / small / medium / large-v3
WHISPER_COMPUTE=int8      # int8 быстрее, float32 точнее
WHISPER_THREADS=2         # два воркера по два потока быстрее одного на четыре
ASR_BEAM_SIZE=1           # 1 — жадный поиск (быстро), 5 — лучевой (точнее)
ASR_CPU_LIMIT=2           # лимит CPU на один контейнер расшифровки
ASR_IDLE_SLEEP=60

# Хранение аудио: 0 — удалять сразу после расшифровки (рекомендуется).
# На время настройки удобно поставить 3, чтобы можно было перепрогнать.
KEEP_AUDIO_DAYS=3

LOG_LEVEL=INFO
